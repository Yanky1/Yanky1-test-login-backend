{
  "Logging": { "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning", "Microsoft.EntityFrameworkCore": "Warning" } },
  "AllowedHosts": "*",
  "Database": { "Provider": "Sqlite", "ConnectionString": "Data Source=App_Data/solvelt.db", "AutoMigrate": false },
  "App": {
    "CorsOrigins": [ "http://localhost:5173" ],
    "FrontendBaseUrl": "http://localhost:5173",
    "MarketplaceUrl": "https://example.com/marketplace",
    "TermsVersion": "2026-01",
    "SellerAgreementVersion": "2026-01",
    "SmsWordingVersion": "2026-01",
    "UseHttpsRedirection": true,
    "UseHsts": true
  },
  "Jwt": { "Issuer": "solvelt-api", "Audience": "solvelt-portal", "AccessTokenMinutes": 60, "KeyId": "k1" },
  "Session": { "IdleTimeoutMinutes": 20, "RefreshTokenDays": 30 },
  "Lockout": { "MaxFailures": 5, "LockMinutes": 15, "CaptchaAtFailures": 4, "WarnAtFailures": 3 },
  "RateLimit": { "AuthPerMinute": 20, "SensitivePerMinute": 10 },
  "Email": { "Provider": "Smtp", "FromAddress": "no-reply@example.com", "FromName": "Solvelt", "SmtpHost": "localhost", "SmtpPort": 1025 },
  "Passkeys": { "RelyingPartyId": "localhost", "AllowedOrigins": [ "http://localhost:5173" ] },
  "Storage": { "LocalRoot": "App_Data/uploads" },
  "Passwords": { "CheckPwned": false },
  "ExternalAuth": { "AppleEnabled": false }
}
