# Solvelt seller-portal API: environment-variable form of every configuration key (ASP.NET Core uses __ as the section separator).
# PLACEHOLDERS ONLY. Never commit real values. See docs/SETUP-INTEGRATIONS.md for what each key does and which environments need it.
# Lines marked "secret" must come from a secret manager in staging/production. Values shown without CHANGE_ME are the code defaults.
# Arrays: Key__0, Key__1 ...  Dictionaries: Key__<name>.  PEM values need real line breaks (use a secret manager or "$(cat file.pem)").

# ---- Environment --------------------------------------------------------------------------------------------------------
# Development | Staging (test-mode staging: any name other than Development/Testing) | Production
ASPNETCORE_ENVIRONMENT=Production

# ---- Database ------------------------------------------------------------------------------------------------------------
Database__Provider=Postgres
# secret
Database__ConnectionString=Host=db.example.com;Database=solvelt;Username=solvelt;Password=CHANGE_ME;SSL Mode=Require
Database__AutoMigrate=false

# ---- App -----------------------------------------------------------------------------------------------------------------
# secret, required outside Development/Testing (openssl rand -hex 32)
App__HmacSecret=CHANGE_ME_RANDOM_64_HEX
App__FrontendBaseUrl=https://seller.example.com
App__CorsOrigins__0=https://seller.example.com
App__MarketplaceUrl=https://www.example.com
App__TermsVersion=2026-01
App__SellerAgreementVersion=2026-01
App__SmsWordingVersion=2026-01
App__UseHttpsRedirection=true
App__UseHsts=true
# reverse proxy IP address(es), single IPs only
# App__TrustedProxies__0=CHANGE_ME_PROXY_IP   (parsed at startup: an invalid value stops the app)

# ---- JWT and sessions ----------------------------------------------------------------------------------------------------
# secret, required outside Development/Testing: PKCS#8 PEM (openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:3072)
Jwt__PrivateKeyPem=CHANGE_ME_PKCS8_PEM
Jwt__KeyId=2026-11
Jwt__Issuer=https://api.example.com
Jwt__Audience=solvelt-portal
Jwt__AccessTokenMinutes=60
# during rotation only: old public key by kid
# Jwt__PreviousPublicKeys__2026-05=CHANGE_ME_OLD_PUBLIC_KEY_PEM
Session__IdleTimeoutMinutes=20
Session__RefreshTokenDays=30
Session__RefreshCookiePath=/api/v1/auth
Session__RefreshGraceSeconds=30

# ---- Data Protection and file storage ------------------------------------------------------------------------------------
DataProtection__KeysPath=/var/lib/solvelt/dp-keys
Storage__LocalRoot=/var/lib/solvelt/uploads

# ---- Lockout, passwords --------------------------------------------------------------------------------------------------
Lockout__MaxFailures=5
Lockout__LockMinutes=15
Lockout__FailureWindowMinutes=15
Lockout__CaptchaAtFailures=4
Lockout__WarnAtFailures=3
Passwords__CheckPwned=true

# ---- Turnstile -----------------------------------------------------------------------------------------------------------
Turnstile__SiteKey=CHANGE_ME
# secret
Turnstile__SecretKey=CHANGE_ME
# Testing environment only (startup fails elsewhere)
Turnstile__UseTestStub=false

# ---- Email ---------------------------------------------------------------------------------------------------------------
# Smtp | Resend | Sink (Sink is for Development/Testing)
Email__Provider=Resend
Email__FromAddress=no-reply@mail.example.com
Email__FromName=Solvelt
# required outside Development/Testing; a real monitored address (example.* / .invalid / .localhost are refused)
Email__SupportAddress=CHANGE_ME_SUPPORT_ADDRESS
# secret (Resend)
Email__ResendApiKey=CHANGE_ME
Email__SmtpHost=smtp.example.com
Email__SmtpPort=587
Email__SmtpUseSsl=true
Email__SmtpUser=CHANGE_ME
# secret (SMTP)
Email__SmtpPassword=CHANGE_ME
Email__SendInBackground=true

# ---- Passkeys ------------------------------------------------------------------------------------------------------------
Passkeys__RelyingPartyId=example.com
Passkeys__AllowedOrigins__0=https://seller.example.com

# ---- External sign-in ----------------------------------------------------------------------------------------------------
ExternalAuth__GoogleClientId=CHANGE_ME.apps.googleusercontent.com
# secret
ExternalAuth__GoogleClientSecret=CHANGE_ME
ExternalAuth__AppleEnabled=false
ExternalAuth__AppleClientId=com.example.seller.web
ExternalAuth__AppleTeamId=CHANGE_ME
ExternalAuth__AppleKeyId=CHANGE_ME
# secret: contents of the .p8 key
ExternalAuth__ApplePrivateKeyPem=CHANGE_ME_P8_PEM

# ---- Admin ---------------------------------------------------------------------------------------------------------------
# first Super admin, created at startup if missing; remove after first sign-in (secret)
AdminSeed__Email=CHANGE_ME_ADMIN_EMAIL
AdminSeed__Password=CHANGE_ME_STRONG_PASSWORD
Admin__SessionMinutes=60
Admin__IdleMinutes=15
Admin__StepUpMinutes=5
Admin__InviteDays=3
# Admin__IpAllowlist__0=CHANGE_ME_OFFICE_CIDR   (e.g. a documentation range like 203.0.113.0/24; empty = no restriction)
Admin__ReadsPerMinute=240
Admin__WritesPerMinute=60
Admin__RevealsPerMinute=20
Admin__MaxExportRows=50000

# ---- Marketplace integration: signed internal API + outbox webhooks (Orders) ------------------------------------------------
# secret, SHARED WITH THE MARKETPLACE (it signs requests to us). Required outside Development/Testing.
Orders__InboundSecret=CHANGE_ME_RANDOM_INBOUND
# secret, SHARED WITH THE MARKETPLACE (it verifies our webhooks). Must differ from InboundSecret.
Orders__OutboundSecret=CHANGE_ME_DIFFERENT_RANDOM_OUTBOUND
Orders__WebhookUrl=https://www.example.com/hooks/solvelt
Orders__TimestampWindowSeconds=300
Orders__MaxInboundBodyBytes=262144
Orders__OutboxMaxAttempts=8
Orders__OutboxBackoffSeconds=30
Orders__FeeBasisPoints=1000
Orders__AutoAcceptMinutes=0
Orders__DefaultHandlingDays=2
Orders__ReturnWindowDays=30
Orders__RedactAfterDays=90
Orders__ManagerRefundLimitCents=0
Orders__ReplyDueHours=24
Orders__BlockContactDetails=false
Orders__MaxAttachmentBytes=5242880
Orders__MaxAttachmentsPerMessage=5
Orders__StreamRecheckSeconds=15
Orders__RunBackgroundJobs=true

# ---- Stripe Connect (payouts) --------------------------------------------------------------------------------------------
# secret: sk_test_/rk_test_ outside Production, sk_live_/rk_live_ in Production (also read from STRIPE_SECRET_KEY)
Stripe__SecretKey=CHANGE_ME_STRIPE_SECRET_KEY
# secret: endpoint signing secret whsec_... (also read from STRIPE_WEBHOOK_SECRET)
Stripe__WebhookSecret=CHANGE_ME_STRIPE_WEBHOOK_SECRET
# secret: signing secret of the Connect endpoint (also read from STRIPE_CONNECT_WEBHOOK_SECRET); required with a live key
Stripe__ConnectWebhookSecret=CHANGE_ME_STRIPE_CONNECT_WEBHOOK_SECRET
# accept a live key with only one webhook secret, on purpose
Payments__AllowSingleWebhookSecret=false
Stripe__DefaultCountry=US
# alternative names, used only when the Stripe__ keys above are empty
# STRIPE_SECRET_KEY=CHANGE_ME
# STRIPE_WEBHOOK_SECRET=CHANGE_ME
# STRIPE_CONNECT_WEBHOOK_SECRET=CHANGE_ME
Payments__AllowTestKeysInProduction=false
Payments__AllowLiveKeysOutsideProduction=false
Payments__ReleaseDays=7
Payments__RequireReturnWindowClosed=true
Payments__NewSellerReservePercent=10
Payments__NewSellerDays=90
Payments__ReserveReleaseDays=30
Payments__MinTransferCents=500
Payments__TransferMaxAttempts=5
Payments__TransferBackoffSeconds=60
Payments__DefaultDisputeFeeCents=1500
Payments__WebhookToleranceSeconds=300
Payments__RunBackgroundJobs=true
Payments__JobIntervalSeconds=300
Payments__LeaseSeconds=300
Payments__ReconcileDays=35
Payments__WebhooksPerMinute=1200

# ---- Shippo (shipping) ---------------------------------------------------------------------------------------------------
# secret: shippo_test_ outside Production, shippo_live_ in Production (also read from SHIPPO_API_KEY)
Shipping__ShippoApiKey=CHANGE_ME_SHIPPO_TOKEN
# alternative name, used only when Shipping__ShippoApiKey is empty
# SHIPPO_API_KEY=CHANGE_ME
# secret: appears as ?token= in the Shippo webhook URL; required in Production with a key
Shipping__WebhookSecret=CHANGE_ME_RANDOM_SHIPPING_WEBHOOK
# secret, portal-only: signs return-label links. Required outside Development/Testing; must differ from both Orders secrets.
Shipping__LinkKey=CHANGE_ME_RANDOM_LINK_KEY
Shipping__PublicBaseUrl=https://api.example.com
Shipping__AllowTestKeyInProduction=false
Shipping__AllowLiveKeyOutsideProduction=false
Shipping__LabelFormat=PDF_4x6
Shipping__QuoteMinutes=15
Shipping__SpendLimitCentsPerMonth=0
Shipping__LabelLinkMinutes=1440
Shipping__TrackingPollAfterHours=24
Shipping__TrackingStopDays=60
Shipping__RefundCheckMinutes=30
Shipping__PollBatch=50
Shipping__PurchaseStuckMinutes=10
Shipping__PurchaseAbandonDays=3
Shipping__ManualDeliveryGraceHours=48
Shipping__PollLeaseMinutes=5
Shipping__JobIntervalSeconds=300
Shipping__WebhookToleranceSeconds=300
Shipping__WebhooksPerMinute=600
Shipping__MaxBulk=25
Shipping__RunBackgroundJobs=true

# ---- Local delivery ------------------------------------------------------------------------------------------------------
# secret, portal-only: signs proof-of-delivery links. Required outside Development/Testing; must differ from both Orders secrets (and from Shipping__LinkKey).
LocalDelivery__ProofUrlKey=CHANGE_ME_RANDOM_PROOF_KEY
LocalDelivery__ProofUrlMinutes=60
LocalDelivery__LocationRetentionHours=24
LocalDelivery__EtaEventSeconds=60
LocalDelivery__MaxProofBytes=8388608

# ---- Bookings ------------------------------------------------------------------------------------------------------------
Bookings__HoldMinutes=10
Bookings__RedactAfterDays=30
Bookings__DefaultTimeZone=UTC
Bookings__MaxAvailabilityDays=62
Bookings__IcsIncludeBuyerName=false
Bookings__RunBackgroundJobs=true

# ---- Phone / SMS (SignalWire or Twilio) ----------------------------------------------------------------------------------
Phone__Enabled=false
# Sink (Development/Testing only) | SignalWire | Twilio
Phone__Provider=SignalWire
Phone__Space=example.signalwire.com
Phone__AccountSid=CHANGE_ME
# secret
Phone__AuthToken=CHANGE_ME
# secret (SignalWire Signing Key; Twilio: the auth token)
Phone__SigningKey=CHANGE_ME
Phone__ApiBaseUrl=
Phone__FromNumber=+15550000000
Phone__PublicBaseUrl=https://api.example.com
Phone__Voice=Polly.Joanna
Phone__Language=en-US
Phone__DefaultRegion=US
Phone__SupportNumber=+15550000001
Phone__HelpContact=CHANGE_ME_SUPPORT_ADDRESS
Phone__BrandName=Solvelt
Phone__CallStateMinutes=10
Phone__PhoneSessionMinutes=10
Phone__SmsSessionMinutes=15
Phone__SignupLinkMinutes=30
Phone__NumberPerMinute=30
Phone__IpPerMinute=600
Phone__SendInBackground=true

# ---- Anthropic (phone AI + seller assistant) -----------------------------------------------------------------------------
# secret (also read from ANTHROPIC_API_KEY); used by both Ai and Assistant
Ai__ApiKey=CHANGE_ME
# ANTHROPIC_API_KEY=CHANGE_ME
# Fake | Anthropic (phone/SMS conversations)
Ai__Provider=Fake
Ai__Model=claude-opus-5-5
Ai__VoiceModel=claude-haiku-5-5
Ai__TimeoutSeconds=8
Ai__VoiceTimeoutSeconds=4
Ai__MaxTokens=400
Assistant__Enabled=true
Assistant__KillSwitch=false
# Fake | Anthropic (seller assistant; Fake is forced off in Production)
Assistant__Provider=Anthropic
Assistant__Model=claude-opus-5-5
Assistant__Effort=medium
Assistant__MaxTokens=16000
Assistant__MaxIterations=8
Assistant__CallTimeoutSeconds=60
Assistant__ToolTimeoutSeconds=20
Assistant__MaxMessageChars=4000
Assistant__MaxToolResultChars=12000
Assistant__HistoryMessages=24
Assistant__DailyMessagesPerUser=150
Assistant__DailyMessagesPerAccount=1500
Assistant__DailyTokensPerUser=600000
Assistant__DailyTokensPerAccount=6000000
Assistant__ActionExpiryMinutes=10
Assistant__RetentionDays=90
Assistant__InputUsdPerMTok=4
Assistant__OutputUsdPerMTok=20
Assistant__RunBackgroundJobs=true

# ---- Rate limits (per minute) --------------------------------------------------------------------------------------------
RateLimit__AuthPerMinute=20
RateLimit__SensitivePerMinute=10
RateLimit__TeamPerMinute=60
RateLimit__CatalogPerMinute=240
RateLimit__OrdersPerMinute=300
RateLimit__InternalPerMinute=1200
RateLimit__InternalCatalogPerMinute=1200
RateLimit__InternalQuestionsPerListingPerMinute=60
RateLimit__InternalQuestionsPerCallerPerMinute=2000
RateLimit__InternalReportsPerTargetPerMinute=60
RateLimit__InternalReportsPerCallerPerMinute=2000
RateLimit__InternalUnsignedPerMinute=60
RateLimit__BookingsPerMinute=300
RateLimit__AvailabilityPerMinute=600
RateLimit__AvailabilityFailedPerMinute=60
RateLimit__PaymentsPerMinute=120
RateLimit__ShippingPerMinute=240
RateLimit__AssistantPerMinute=30

# ---- Opt-in test projects only (never set these on a server) -------------------------------------------------------------
# STRIPE_SECRET_KEY=sk_test_CHANGE_ME      dotnet test tests/Solvelt.Api.StripeTests
# SHIPPO_API_KEY=shippo_test_CHANGE_ME     dotnet test tests/Solvelt.Api.ShippoTests
# SOLVELT_PG_ADMIN="Host=localhost;Username=postgres;Password=CHANGE_ME;Database=postgres"   dotnet test tests/Solvelt.Api.PostgresTests
# ANTHROPIC_API_KEY=CHANGE_ME              dotnet test tests/Solvelt.Api.Evals
# ORDERS_INBOUND_SECRET=CHANGE_ME          scripts/post-signed.sh GET /api/internal/v1/catalog/categories "" https://api.example.com
