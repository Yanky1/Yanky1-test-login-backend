# Environment-variable form of appsettings.Example.json (ASP.NET Core uses __ as the section separator). Placeholders only.
ASPNETCORE_ENVIRONMENT=Production
Database__Provider=Postgres
Database__ConnectionString=Host=db;Database=solvelt;Username=solvelt;Password=CHANGE_ME
App__HmacSecret=CHANGE_ME_64_RANDOM_CHARS
App__FrontendBaseUrl=https://seller.example.com
App__CorsOrigins__0=https://seller.example.com
Jwt__PrivateKeyPem=CHANGE_ME
Jwt__KeyId=2026-11
Turnstile__SiteKey=CHANGE_ME
Turnstile__SecretKey=CHANGE_ME
Email__Provider=Resend
Email__ResendApiKey=CHANGE_ME
Passkeys__RelyingPartyId=example.com
Passkeys__AllowedOrigins__0=https://seller.example.com
ExternalAuth__GoogleClientId=CHANGE_ME
ExternalAuth__GoogleClientSecret=CHANGE_ME
